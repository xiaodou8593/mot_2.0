#$(module_prefix)perf/$(perf_name)/_expr
# 开始性能实验
# 输出记录实体entity @e[tag=result,limit=1]

tag @e[tag=result] remove result
summon marker 0 0 0 {Tags:["$(module_prefix)perf/$(perf_name)","perf_v_test","result"],CustomName:'"$(module_prefix)perf/$(perf_name)"'}
execute as @e[tag=result,limit=1] run function $(module_prefix)perf/$(perf_name)/set_operations